# ========================================================
# CampusLoop Environment Configuration Example
# Copy this file to .env and adjust as needed.
# ========================================================

# Backend Database
# Local SQLite default (zero setup needed) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campusloop
DATABASE_URL=sqlite:///./campusloop.db

# Security & Authentication
JWT_SECRET=campusloop-development-secret-key-replace-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & Networking
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (for frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
