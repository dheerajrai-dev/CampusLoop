# ==============================================================================
# CampusLoop Environment Configuration Template
# Copy this file to .env for local development or production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=production
# Set to true to automatically seed demo campus & sample listings if database is empty
AUTO_SEED=true

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# SQLite (default for development or single-container deployment):
DATABASE_URL=sqlite:///./campusloop.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg://campusloop_user:your_secure_password@localhost:5432/campusloop
# For cloud hosted Postgres (Supabase, Neon, Render, AWS RDS):
# DATABASE_URL=postgresql+psycopg://user:password@host.provider.com:5432/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a cryptographically random secret in production!
# Run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=campusloop-development-secret-key-replace-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Server & Networking
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed origins. Use "*" only in development.
# In production, specify your real domain(s), e.g.:
# CORS_ORIGINS=https://campusloop.edu,https://www.campusloop.edu
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Production Docker Compose (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
POSTGRES_DB=campusloop
POSTGRES_USER=campusloop_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
HTTP_PORT=80

# ------------------------------------------------------------------------------
# 6. Frontend Build Variables (frontend/.env)
# ------------------------------------------------------------------------------
# Leave empty or omit if frontend is served by FastAPI or reverse-proxied under same origin.
# If frontend is hosted separately (e.g., Vercel, Netlify):
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=
